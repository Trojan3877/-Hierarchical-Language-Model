# Hugging Face (optional if running locally only)
HF_TOKEN=your_hf_token_here

# LangSmith (optional observability)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=

# RAG configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GENERATION_MODEL=google/flan-t5-base

# Vector store: keep "faiss" for offline local development.
VECTORSTORE_BACKEND=faiss
FAISS_INDEX_DIR=data/index.faiss

# Pinecone is required only when VECTORSTORE_BACKEND=pinecone.
# Use a Pinecone index whose dimension matches EMBEDDING_MODEL.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=hlm-documents
PINECONE_NAMESPACE=hlm-documents
